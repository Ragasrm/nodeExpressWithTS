{
  "name": "backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented Express + MongoDB API (TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
